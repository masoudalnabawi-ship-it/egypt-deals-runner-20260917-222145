async def main():
    print(
        "🚀 AMAZON MULTI-SOURCE RADAR STARTED",
        flush=True
    )

    await asyncio.gather(
        discovery_loop(),
        hot_loop(),
        ultra_hot_loop(),
        competitor_loop(),
        external_sources_loop(),
        extra_store_trigger_loop(),
        manual_watch_loop(),
        unified_queue_loop()
    )


asyncio.run(main())
